# Copy this to api-gateway/.env, auth-service/.env, booking-service/.env

# === MCP Hub Backend ===
MCP_URL=http://localhost:3001

# === Project Identity ===
# Set this to the projectId of the project you created in the MCP Hub UI
PROJECT_ID=your_project_id_here

# === Service Ports ===
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
BOOKING_SERVICE_PORT=4002

# === Internal Service URLs (used by api-gateway) ===
AUTH_SERVICE_URL=http://localhost:4001
BOOKING_SERVICE_URL=http://localhost:4002

# === MongoDB (same instance as MCP Hub) ===
MONGO_URI=mongodb://localhost:27017/mcphub
