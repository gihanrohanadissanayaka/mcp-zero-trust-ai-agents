# MCP Hub Server - Environment Template
# Copy this to .env and update with your values

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# MongoDB connection string (required) — choose ONE:

# Option 1: Local MongoDB (default port, no auth)
MONGO_URL=mongodb://localhost:27017

# Option 2: Local MongoDB with auth
# MONGO_URL=mongodb://username:password@localhost:27017/mcphub?authSource=admin

# Option 3: MongoDB Atlas (cloud)
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mcphub?retryWrites=true&w=majority

# Database name (optional, defaults to "mcphub")
DB_NAME=mcphub

# =====================================================
# SECURITY CONFIGURATION
# =====================================================
# API Keys for MCP access (generate secure random strings)
MCP_API_KEY=mcphub_your_secure_api_key_here
MCP_ADMIN_KEY=mcphub_admin_your_secure_admin_key_here

# JWT Configuration (generate a secure random string, min 64 characters)
JWT_SECRET=your_super_secure_jwt_secret_minimum_64_characters_for_production_use
BCRYPT_ROUNDS=12
# Access token lifetime in seconds (default: 3600 = 1 hour)
SESSION_TIMEOUT=3600
# Refresh token lifetime in seconds (default: 604800 = 7 days)
REFRESH_TIMEOUT=604800

# Security Settings
ENABLE_AUDIT_LOG=true
RATE_LIMIT_PER_MINUTE=100

# Default Admin Account (change immediately after first setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password
ADMIN_EMAIL=admin@yourcompany.com

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
NODE_ENV=production
PORT=3001

# Set to true to run Express API only (no MCP stdio transport).
# Use this for development/testing with Postman.
# Set to false (or remove) when running as a real MCP server.
SKIP_MCP_STDIO=false