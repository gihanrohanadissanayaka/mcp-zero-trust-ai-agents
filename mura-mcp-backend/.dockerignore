# Docker ignore patterns for mcp-hub single container
# Prevent sensitive and unnecessary files from being copied to Docker image

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (should be passed as Docker environment variables)
.env*
!.env.example

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/
.nyc_output

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore

# Docker files (they're not needed inside the container)
Dockerfile*
docker-compose*
.dockerignore

# Documentation
README.md
docs/
*.md

# Development and deployment scripts
scripts/deploy-*
scripts/setup-*
scripts/test-*

# Test files
test/
tests/
__tests__/
*.test.js
*.spec.js

# Temporary files
tmp/
temp/
.tmp/

# Build artifacts
dist/
build/

# Package manager lock files (we copy package.json separately)
package-lock.json
yarn.lock

# Backup files
*.backup
*.bak